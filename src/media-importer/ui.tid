title: $:/plugins/mblackman/media-importer/ui
caption: Media Importer

<div style="max-width: 1000px; margin: 0 auto;">

<div class="mi-section">
  <div class="mi-flex-row" style="gap:10px; margin-bottom: 15px; border-bottom: 1px solid <<colour table-border>>; padding-bottom: 10px;">
    <h2 style="margin:0; font-size: 1.5em; color:<<colour primary>>; line-height:1;">📥 Import Media</h2>
  </div>
  
  <div style="margin-top: 10px;">
    
    <$let
      defaultTab={{{ [[$:/plugins/mblackman/media-importer/data/importers]indexes[]first[]] }}}
      activeType={{{ [[$:/state/media-importer-selected]get[text]else<defaultTab>] }}}
      importersJson={{{ [[$:/plugins/mblackman/media-importer/data/importers]get[text]] }}}
    >
      <!-- Segmented Media Type Pill Selector -->
      <div class="mi-segmented-bar" role="tablist" aria-label="Media type selector">
        <$list filter="[[$:/plugins/mblackman/media-importer/data/importers]indexes[]]" variable="importerType">
          <$button
            class={{{ [<activeType>match<importerType>then[tc-btn-invisible mi-segmented-pill mi-segmented-pill-active]else[tc-btn-invisible mi-segmented-pill]] }}}
          >
            <$action-setfield $tiddler="$:/state/media-importer-selected" text=<<importerType>> />
            <$list filter="[[$:/temp/media-importer/search-input]!has[title]]">
              <$action-setfield $tiddler="$:/temp/media-importer/search-input" text="" />
            </$list>
            <!-- If a search query is already typed, automatically search the newly selected media type -->
            <$let currentQuery={{{ [[$:/temp/media-importer/search-input]get[text]trim[]] }}}>
              <$list filter="[<currentQuery>!is[blank]]" variable="ignore">
                <$action-setfield $tiddler={{{ [[$:/state/]addsuffix<importerType>addsuffix[-search-page]] }}} text="1" />
                <$action-sendmessage $message={{{ [[tm-search-]addsuffix<importerType>] }}} $param=<<currentQuery>> page="1" />
              </$list>
            </$let>
            <span class="mi-segmented-pill-icon">
              <$text text={{{ [<importersJson>jsonget<importerType>,[icon]] }}} />
            </span>
            <span class="mi-segmented-pill-label">
              <$text text={{{ [<importersJson>jsonget<importerType>,[label]else<importerType>] }}} />
            </span>
          </$button>
        </$list>
      </div>

      <!-- Unified Shared Search & Results -->
      <$MediaImporter
          type=<<activeType>>
          inputTiddler="$:/temp/media-importer/search-input"
          label={{{ [<importersJson>jsonget<activeType>,[caption]] }}}
          placeholder={{{ [<importersJson>jsonget<activeType>,[placeholder]] }}}
          loadingText={{{ [<importersJson>jsonget<activeType>,[loadingText]] }}}
          resultTag={{{ [<importersJson>jsonget<activeType>,[resultTag]] }}}
          imageField={{{ [<importersJson>jsonget<activeType>,[imageField]] }}}
          subtitleContent={{{ [<importersJson>jsonget<activeType>,[subtitle]] }}}
      >
          <div class="mi-flex-row mi-unified-search-row">
              <$keyboard key="enter" message="ui-trigger-search" class="mi-flex-grow">
                  <$edit-text
                      tiddler="$:/temp/media-importer/search-input"
                      tag="input"
                      default=""
                      placeholder={{{ [<importersJson>jsonget<activeType>,[placeholder]] }}}
                      class="mi-input mi-unified-search-input"
                  />
              </$keyboard>
              <$button class="mi-btn mi-btn-primary" message="ui-trigger-search">Search</$button>
              <$button class="mi-btn" message="ui-clear-search">Clear</$button>
          </div>
      </$MediaImporter>
    </$let>

  </div>
</div>

<div>
  <div>
    <div class="mi-flex-row mi-flex-between" style="margin-bottom: 15px;">
      <h3 style="margin: 0; font-size: 1.1em; text-transform: uppercase; letter-spacing: 1px; color: <<colour muted-foreground>>;">
        ⏱️ Recently Added
      </h3>
      <$link to="$:/plugins/mblackman/media-importer/ui/media-library" class="mi-btn" style="padding: 4px 12px; font-size: 0.75em;">
        Open Full Library →
      </$link>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 15px;">
      <$list filter="[tag[$:/tags/media-importer/Media]!sort[created]limit[8]]" emptyMessage="<div style='grid-column: 1/-1; padding:20px; font-style:italic; text-align:center; opacity:0.6;'>No items added yet.</div>">
        
        <$link to={{!!title}} style="text-decoration: none; display: block; color: inherit;">
        <div class="mi-card" style="padding: 0; overflow: hidden; position: relative; aspect-ratio: 1/1; margin-bottom: 0; border: none;">
          
          <$image source={{!!image}} style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;" />
          
          <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 70%; background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.85)); pointer-events: none;"></div>

          <span style="position: absolute; top: 6px; right: 6px; font-size:0.65em; font-weight: bold; text-transform:uppercase; background: rgba(0,0,0,0.75); color: #fff; padding: 2px 6px; border-radius: 4px;">
            {{!!media-type}}
          </span>

          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 10px; z-index: 1;">
            <div style="font-weight: 600; font-size: 0.85em; line-height: 1.2; margin-bottom: 2px; text-shadow: 0 1px 2px rgba(0,0,0,0.8); color: #fff;">
              <$view field="title"/>
            </div>
            <div style="font-size: 0.7em; color: rgba(255,255,255,0.75);">
               <$view field="created" format="date" template="YYYY-0MM-0DD"/>
            </div>
          </div>
        </div>
        </$link>
      </$list>
    </div>
  </div>
</div>
</div>