title: $:/plugins/mblackman/media-importer/macros/ui
tags: $:/tags/Macro

\define media-importer-ui(type, label, placeholder, loadingText, resultTag, imageField:"draft_image", imageStyle:"width:50px; height:auto;", subtitleContent)

<$keyboard key="enter" actions="<$action-setfield $tiddler='$:/state/$type$-search-page' text='1'/><$action-sendmessage $message='tm-search-$type$' $param={{$:/temp/$type$-search-input}} page='1'/>">
  <div class="mi-flex-row" style="margin-bottom:20px;">
    <$edit-text tiddler="$:/temp/$type$-search-input" tag="input" focus="yes" default="" placeholder="$placeholder$" class="mi-input mi-flex-grow"/>
    
    <$button class="mi-btn mi-btn-primary" actions="<$action-setfield $tiddler='$:/state/$type$-search-page' text='1'/><$action-sendmessage $message='tm-search-$type$' $param={{$:/temp/$type$-search-input}} page='1'/>">
      Search
    </$button>
    
    <$button actions="""
      <$action-deletetiddler $filter="[tag[$resultTag$]]"/>
      <$action-setfield $tiddler="$:/state/$type$-search" text=""/>
      <$action-setfield $tiddler="$:/state/$type$-search-page" text="1"/>
      <$action-setfield $tiddler="$:/temp/$type$-search-input" text=""/>
    """>
      Clear
    </$button>
  </div>
</$keyboard>

<div style={{{ [[$:/state/$type$-search]get[text]!is[blank]then[min-height: 400px;]] }}}>
<$list filter="[[$:/state/$type$-search]get[text]match[loading]]">
  <div class="mi-section">
    <p><i>$loadingText$</i></p>
  </div>
</$list>

<$list filter="[tag[$resultTag$]sort[draft_title]]">
  <div class="mi-card mi-flex-row mi-flex-between">
    
    <div style="flex-shrink:0;">
       <$list filter="[all[current]has[$imageField$]]">
          <img src={{!!$imageField$}} style="$imageStyle$"/>
       </$list>
    </div>

    <div>
       <b>{{!!draft_title}}</b> <small>({{!!draft_year}})</small><br/>
       <small>$subtitleContent$</small>
    </div>

    <div class="mi-ml-auto">
      <$button class="mi-btn mi-btn-primary" actions="<$action-sendmessage $message='tm-fetch-$type$' $param=<<currentTiddler>>/>">
         Import
      </$button>
    </div>

  </div>
</$list>

<$list filter="[[$:/state/$type$-search]text[done]]">
  <$list filter="[tag[$resultTag$]count[]match[0]]">
     <div class="mi-section"><p><i>No results found.</i></p></div>
  </$list>
</$list>
</div>

<$list filter="[tag[$resultTag$]limit[1]] [[$:/state/$type$-search-page]get[text]else[1]!match[1]] +[limit[1]]">
  <div class="mi-flex-row" style="gap: 10px; margin-top: 15px; justify-content: center; align-items: center;">
    
    <$list filter="[[$:/state/$type$-search-page]get[text]else[1]!match[1]]">
    <$button class="mi-btn">
       ← Prev
       <$action-setfield $tiddler="$:/state/$type$-search-page" $value={{{ [[$:/state/$type$-search-page]get[text]else[1]subtract[1]] }}} />
       <$action-sendmessage $message="tm-search-$type$" $param={{$:/temp/$type$-search-input}} page={{{ [[$:/state/$type$-search-page]get[text]else[1]subtract[1]] }}}/>
    </$button>
    </$list>

    <span style="font-size:0.9em; opacity:0.7;">Page <$text text={{{ [[$:/state/$type$-search-page]get[text]else[1]] }}}/></span>

    <$button class="mi-btn" disabled={{{ [tag[$resultTag$]count[]match[0]then[yes]] }}}>
       Next →
       <$action-setfield $tiddler="$:/state/$type$-search-page" $value={{{ [[$:/state/$type$-search-page]get[text]else[1]add[1]] }}} />
       <$action-sendmessage $message="tm-search-$type$" $param={{$:/temp/$type$-search-input}} page={{{ [[$:/state/$type$-search-page]get[text]else[1]add[1]] }}}/>
    </$button>

  </div>
</$list>
\end

\define media-picker(date, placeholder:"Search your media...")
<$let 
  targetDate={{{ [<__date__>!is[blank]else<now YYYY-MM-DD>] }}}
  targetTiddler={{{ [[$:/media-log/]addsuffix<targetDate>] }}}
>
<div class="mi-media-wrapper">
  <!-- List of added items (Chips) -->
  <div style="margin-bottom: 4px;">
    <$list filter="[<targetTiddler>get[media-log]enlist-input[]]" variable="item">
      <span style="display: inline-block; background: <<colour tiddler-info-background>>; border: 1px solid <<colour tiddler-info-border>>; border-radius: 12px; padding: 2px 10px; margin: 2px 4px 2px 0; font-size: 0.9em;">
        <$button class="tc-btn-invisible" tooltip="Remove" style="margin-right: 4px; color: <<colour muted-foreground>>;">
          <$action-listops $tiddler=<<targetTiddler>> $field="media-log" $subfilter="-[<item>]"/>
          ×
        </$button>
        <$link to=<<item>> style="text-decoration: none; color: <<colour foreground>>;" />
      </span>
    </$list>
  </div>

  <!-- Search & Select -->
  <$let 
    tempState={{{ [[$:/temp/journal/picker/]addsuffix<targetTiddler>addsuffix[/]addsuffix[media-log]] }}}
  >
    <div class="mi-media-picker-input-wrapper">
      <div style="position:relative;">
        <$edit-text tiddler=<<tempState>> tag="input" class="mi-input" placeholder="$placeholder$" default="" />
        <$reveal state=<<tempState>> type="nomatch" text="">
          <$button class="tc-btn-invisible mi-media-picker-clear-btn">
            <$action-setfield $tiddler=<<tempState>> text="" />✕
          </$button>
        </$reveal>
      </div>
      
      <$reveal state=<<tempState>> type="nomatch" text="" animate="yes">
        <$button class="mi-media-picker-overlay">
          <$action-setfield $tiddler=<<tempState>> text="" />
        </$button>
        <div class="tc-drop-down mi-media-picker-dropdown">
          <$let query={{{ [<tempState>get[text]] }}}>
            <$list filter="[tag[MediaType]!is[system]search:title<query>sort[title]limit[15]]" emptyMessage="<div class='tc-dropdown-item mi-disabled-item'>No matches found</div>">
              <$button class="tc-btn-invisible tc-dropdown-item">
                <$action-listops $tiddler=<<targetTiddler>> $field="media-log" $subfilter={{{ [<currentTiddler>format:titlelist[]] }}} />
                <$action-listops $tiddler=<<targetTiddler>> $tags="$:/tags/media-importer/MediaLog" />
                <$action-setfield $tiddler=<<tempState>> text="" />
                <$view field="title"/> <$list filter="[all[current]has[media-type]]"><span style="opacity:0.6; font-size:0.8em;">({{!!media-type}})</span></$list>
              </$button>
            </$list>
          </$let>
        </div>
      </$reveal>
    </div>
  </$let>
</div>
</$let>
\end

\define media-consumption-summary(startDate, endDate)
<div class="mi-section">
  <$let
    start={{{ [<__startDate__>!is[blank]else[0000-00-00]] }}}
    end={{{ [<__endDate__>!is[blank]else[9999-99-99]] }}}
    journalFilter="[prefix[$:/media-log/]] :filter[removeprefix[$:/media-log/]compare:string:gteq<start>] :filter[removeprefix[$:/media-log/]compare:string:lteq<end>]"
  >
  <$list filter="[tag[MediaType]get[media-type]unique[]sort[]]" variable="mediaType">
    <$let 
      mediaItemsFilter="""[subfilter<journalFilter>get[media-log]enlist-input[]] :filter[media-type<mediaType>] +[unique[]sort[]]"""
    >
      <$list filter="[subfilter<mediaItemsFilter>count[]!match[0]]" variable="ignore">
        <h5 style="margin-bottom: 5px; margin-top: 15px;"><<mediaType>></h5>
        <div class="mi-summary-group">
          <$list filter="[subfilter<mediaItemsFilter>]" variable="item">
            <div class="mi-summary-item">
              <div class="mi-summary-link"><$link to=<<item>>/></div>
              <span class="mi-summary-badge"><$count filter="""[subfilter<journalFilter>contains:media-log<item>]"""/>d</span>
            </div>
          </$list>
        </div>
      </$list>
    </$let>
  </$list>
  </$let>
</div>
\end